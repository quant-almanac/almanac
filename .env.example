# Use this as a template for ~/.almanac_secrets or your shell environment.
# This repository does not load a project-local .env file. Copy the
# NEXT_PUBLIC_* values separately to frontend/.env.local for the dashboard.
# Never commit real API keys, chat IDs, account balances, or broker exports.

ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
EDINET_API_KEY=
FRED_API_KEY=
FINNHUB_API_KEY=
GEMINI_API_KEY=
GOOGLE_AI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
DASHSCOPE_API_KEY=
TELEGRAM_TOKEN=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ALMANAC_API_KEY=
NEXT_PUBLIC_API_BASE=http://localhost:8000
NEXT_PUBLIC_ALMANAC_API_KEY=

# LLM routing and privacy. strict_local blocks the gated book-aware call
# sites; it is not a process-wide network sandbox (see the README).
# normal keeps the default routed model tiers.
ALMANAC_PRIVACY_MODE=strict_local
ALMANAC_BUDGET_MODE=normal
# on injects measured catalyst context into the one daily final synthesis;
# off keeps the hypothesis log without injecting it. It does not add runs.
ALMANAC_CATALYST_CONTEXT_MODE=on
# Tax-facing values use the account-level total-average-like calculation.
# Incomplete evidence yields unavailable values; FIFO never becomes a fallback.
ALMANAC_TAX_BASIS_MODE=total_average
# off | shadow | advisory. Advisory changes recommendation/sizing policy only;
# it never submits broker orders.
ALMANAC_MARKET_REGIME_V2_MODE=advisory

# Optional backup settings. Encryption is configured in rclone itself.
ALMANAC_OFFSITE_REMOTE=crypt-gdrive:almanac_backup
ALMANAC_REQUIRE_OFFSITE_BACKUP=1

# Optional private employee-share plan settings. Defaults remain disabled.
ALMANAC_ESPP_TICKER=9999.T
ALMANAC_ESPP_MONTHLY_AMOUNT_JPY=0
ALMANAC_ESPP_EMPLOYEE_AMOUNT_JPY=0
ALMANAC_ESPP_BONUS_AMOUNT_JPY=0
ALMANAC_ESPP_INCENTIVE_RATE=0

# JSON array of private recurring cash-flow definitions. Leave empty to disable.
# Example shape: [{"id":"sample","label":"Sample","amount":10000,"currency":"JPY","cadence":"monthly","day_of_month":1,"broker":"sample"}]
ALMANAC_CONTRIBUTION_SCHEDULE_JSON=

# Measurement hygiene: ignore NAV history before the accounting fixes stabilized.
ALMANAC_CLEAN_NAV_SINCE=2026-05-25
ALMANAC_MIN_CLEAN_DAYS=20
